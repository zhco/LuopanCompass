<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bgColor"
    android:gravity="center">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="风水罗盘"
        android:textColor="@color/gold"
        android:textSize="18sp"
        android:fontFamily="serif"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:shadowColor="@color/darkGold"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2" />

    <com.fengshui.luopan.LuopanView
        android:id="@+id/luopanView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 角度和方位 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="4dp"
        android:background="#2A1500">

        <TextView
            android:id="@+id/degreeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0.0°"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:gravity="center"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/directionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="北"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:gravity="center"
            android:fontFamily="serif" />

    </LinearLayout>

    <!-- 地盘坐山朝向 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="3dp"
        android:background="#2A1500">

        <TextView
            android:id="@+id/mountainText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="地盘山: 壬"
            android:textColor="@color/cream"
            android:textSize="12sp"
            android:gravity="center"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/waterText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="地盘水: 丙"
            android:textColor="@color/cream"
            android:textSize="12sp"
            android:gravity="center"
            android:fontFamily="serif" />

    </LinearLayout>

    <!-- 人盘坐山朝向 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="3dp"
        android:background="#2A1500">

        <TextView
            android:id="@+id/renMountainText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="人盘山: 子"
            android:textColor="#DAA520"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/renWaterText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="人盘水: 午"
            android:textColor="#DAA520"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="serif" />

    </LinearLayout>

    <!-- 一百二十分金 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="3dp"
        android:background="#2A1500">

        <TextView
            android:id="@+id/fenJinText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="分金: 甲子"
            android:textColor="#90EE90"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/fenJinStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="吉"
            android:textColor="#90EE90"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="serif" />

    </LinearLayout>

    <!-- 穿山七十二龙 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="3dp"
        android:background="#2A1500">

        <TextView
            android:id="@+id/chuanShanText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="穿山: 甲子"
            android:textColor="#87CEEB"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/chuanShanStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="可用"
            android:textColor="#87CEEB"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="serif" />

    </LinearLayout>

    <!-- 透地六十龙 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="3dp"
        android:background="#2A1500">

        <TextView
            android:id="@+id/touDiText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="透地: 甲子"
            android:textColor="#DDA0DD"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/touDiStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="吉"
            android:textColor="#DDA0DD"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="serif" />

    </LinearLayout>

    <!-- 十二长生宫 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="3dp"
        android:background="#2A1500">

        <TextView
            android:id="@+id/changShengText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="长生: 寅"
            android:textColor="#FFA500"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/changShengStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="吉"
            android:textColor="#FFA500"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="serif" />

    </LinearLayout>

    <!-- 二十八宿 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="3dp"
        android:background="#2A1500">

        <TextView
            android:id="@+id/xiu28Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="二十八宿: 角"
            android:textColor="#98FB98"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/xiu28XiangText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="东方青龙"
            android:textColor="#98FB98"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="serif" />

    </LinearLayout>

    <!-- 九星 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="3dp"
        android:background="#2A1500">

        <TextView
            android:id="@+id/jiuXingText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="九星: 贪狼 (木)"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/jiuXingWuXingText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="吉"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="serif" />

    </LinearLayout>

    <!-- 紫白飞星 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="3dp"
        android:background="#2A1500">

        <TextView
            android:id="@+id/ziBaiText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="紫白: 一白 (水)"
            android:textColor="#90EE90"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/ziBaiStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="吉"
            android:textColor="#90EE90"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="serif" />

    </LinearLayout>

    <!-- 六十四卦 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="3dp"
        android:background="#2A1500">

        <TextView
            android:id="@+id/gua64Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="六十四卦: 乾"
            android:textColor="#87CEEB"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/gua64XiangText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="乾为天"
            android:textColor="#87CEEB"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="serif" />

    </LinearLayout>

    <!-- 四柱干支 -->
    <TextView
        android:id="@+id/siZhuText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="四柱: 甲子年 丙寅月 戊辰日 庚午时"
        android:textColor="#DDA0DD"
        android:textSize="10sp"
        android:gravity="center"
        android:padding="3dp"
        android:background="#2A1500"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/locationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="定位中..."
        android:textColor="@color/darkGold"
        android:textSize="10sp"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:fontFamily="monospace" />

</LinearLayout>
